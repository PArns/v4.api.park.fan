{
  "name": "park-fan-api",
  "version": "4.10.1",
  "description": "Real-time theme park data aggregation API providing wait times, occupancy insights, and ML-ready analytics",
  "author": "Patrick Arns",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "nest build",
    "postbuild": "ts-node -r tsconfig-paths/register scripts/generate-swagger-spec.ts || echo '⚠️  Swagger spec generation skipped (will be generated at runtime)'",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_NO_WARNINGS=1 nest start",
    "dev": "NODE_NO_WARNINGS=1 nest start --watch",
    "start:debug": "NODE_NO_WARNINGS=1 nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "changelog:check": "ts-node -r tsconfig-paths/register src/common/utils/changelog-merge.ts check",
    "changelog:merge": "ts-node -r tsconfig-paths/register src/common/utils/changelog-merge.ts merge",
    "test": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.config.json",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --watch --config jest.config.json",
    "test:cov": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --coverage --config jest.config.json",
    "test:debug": "NODE_ENV=test node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config jest.config.json",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config ./test/jest-e2e.json --watch --runInBand",
    "test:e2e:cov": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config ./test/jest-e2e.json --coverage --runInBand",
    "test:all": "npm run test && npm run test:e2e",
    "test:all:cov": "npm run test:cov && npm run test:e2e:cov",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres redis",
    "db:test:create": "docker exec -it parkfan_postgres psql -U parkfan -c 'CREATE DATABASE parkfan_test;'",
    "db:test:drop": "docker exec -it parkfan_postgres psql -U parkfan -c 'DROP DATABASE IF EXISTS parkfan_test;'",
    "db:test:reset": "npm run db:test:drop && npm run db:test:create",
    "clear-queues": "ts-node scripts/clear-queues.ts",
    "job:ml-train": "ts-node scripts/trigger-ml-training.ts",
    "job:stats-backfill": "ts-node scripts/trigger-stats-backfill.ts",
    "job:baselines-recalc": "ts-node scripts/trigger-baseline-recalculation.ts",
    "job:clear-calendar-cache": "ts-node scripts/clear-calendar-cache.ts",
    "job:children-sync": "ts-node scripts/trigger-children-sync.ts",
    "job:clear-cache": "ts-node scripts/clear-cache.ts",
    "repair:schedule-dates": "ts-node scripts/repair-schedule-dates.ts"
  },
  "dependencies": {
    "@elsikora/string-similarity": "^1.0.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.20.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cron-parser": "^5.10.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "marked": "^18.1.1",
    "maxmind": "^5.0.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "tar": "^7.5.22",
    "transliteration": "^2.6.2",
    "typeorm": "^1.1.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.5.0"
}
