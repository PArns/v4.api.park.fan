# Application
NODE_ENV=production
PORT=3000
API_PREFIX=v1

# Database - PostgreSQL with TimescaleDB
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=parkfan
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=parkfan
DB_SYNCHRONIZE=true
DB_LOGGING=false
# Connection pool size (default 80). Keep it below Postgres max_connections,
# summed over API instances.
# DB_POOL_SIZE=80
# Background-job queries share this many connections (default 12); calendar
# day builds per request (default 6). Both stay well below DB_POOL_SIZE.
# DB_JOB_CONCURRENCY=12
# CALENDAR_DAY_CONCURRENCY=6

# Nest log level: verbose | debug | log | warn | error. Default log.
# LOG_LEVEL=log
# A search taking at least this many ms writes one line to the slow-search log.
# SLOW_SEARCH_THRESHOLD_MS=300

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Bull Queue
BULL_PREFIX=parkfan

# Origin rate limiting (circuit breaker; keyed on CF-Connecting-IP).
# Generous by default so carrier-NAT'd mobile users aren't punished.
# Set THROTTLE_LIMIT=0 to disable.
# THROTTLE_TTL=60
# THROTTLE_LIMIT=300
# Frontend bypass: requests sending THROTTLE_BYPASS_HEADER with one of the
# comma-separated keys skip the limiter. Set a long random secret here and
# in the frontend. Shared secret, not auth — rotate via env, never commit.
# THROTTLE_BYPASS_HEADER=x-auth-key
# THROTTLE_BYPASS_KEYS=CHANGE_ME_LONG_RANDOM_SECRET
# Origin secret: once set, CF-Connecting-IP is believed (by the throttler and the
# trip, push and page-view limiters) only on a request whose CF_ORIGIN_SECRET_HEADER
# carries this value, which a Cloudflare Transform Rule adds. Unset: every
# caller can name its own address. See docs/deployment/edge-and-throttling.md.
# CF_ORIGIN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# CF_ORIGIN_SECRET_HEADER=x-cf-origin-secret

# Browser origins allowed by CORS. Unset: https://park.fan and
# https://www.park.fan. Setting it REPLACES that list; `*` matches inside one
# host label. See docs/deployment/cors.md.
# CORS_ORIGINS=https://park.fan,https://www.park.fan,https://park-*-arns.vercel.app

# The most-read counter's secret before it moved onto the site statistic
# (PAR-1151). Still read as the fallback for ANALYTICS_HASH_SECRET below, so a
# deployment that set it needs no new variable.
# PAGE_VIEWS_HASH_SECRET=replace-with-a-long-random-secret

# Secret for the site statistic's Redis keys (visit, visitor, daily caps,
# `page_read`'s per-reader count): each is an HMAC of address bucket and
# User-Agent under this value, so no key can be traced back to an address
# without it. Unset: PAGE_VIEWS_HASH_SECRET is used; both unset: a random
# secret per process, which keeps addresses out of Redis just the same but
# lets a restart or a second instance count a visitor twice that day. See
# docs/frontend/site-analytics.md.
# ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# External APIs
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
# South Korea holidays (PAR-1065): NEIS school calendars, KASI public holidays.
# Optional — the KR sources are skipped without them.
# NEIS_API_KEY=
# KASI_SERVICE_KEY=
# Weather uses Open-Meteo (no API key required). Weather warnings need the
# MeteoGate token; without it no country syncs, Germany (Bright Sky) included.
# METEOALARM_API_TOKEN=

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:8000
MODEL_DIR=/app/models
# Time budget for the nightly CatBoost training, in minutes; the ml-service skips
# its optional refit when that would not fit. Default 90.
# ML_TRAINING_TIMEOUT_MINUTES=90

# Where the daily ride-profile audit reads park.fan's glossary term ids.
# GLOSSARY_TERM_IDS_URL=https://park.fan/api/glossary-term-ids

# Frontend on-demand revalidation webhook (best-days snapshot refresh).
# After the daily forecast batch refreshes the precomputed best-days snapshots,
# the backend POSTs {tags:[...]} to REVALIDATE_URL so the frontend drops its
# stale best-days cache immediately. Disabled unless REVALIDATE_SECRET is set.
# The secret is sent as `Authorization: Bearer <secret>` (must match frontend).
REVALIDATE_URL=https://park.fan/api/revalidate
REVALIDATE_SECRET=CHANGE_ME_SHARED_WITH_FRONTEND

# ─── Admin authentication ────────────────────────────────────────────────────
# The admin surface has real accounts now (admin_users + Redis sessions), so
# /v1/admin/* needs a signed-in administrator rather than a shared secret.
#
# First run only: creates an owner account when the table is empty. The account
# is created owing a password change, so this value works exactly once — it
# lives in a deployment config and a shell history and should not survive the
# first login. Nothing happens if the table already has accounts.
# ADMIN_BOOTSTRAP_EMAIL=you@park.fan
# ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
#
# The deprecated shared pass. Kept so the maintenance scripts and the curation
# runbooks that still send `?pass=` keep working; every use is logged. Set
# ADMIN_LEGACY_PASS_ENABLED=false to close it once nothing depends on it, or
# narrow what it may do with ADMIN_LEGACY_PASS_ROLE (owner|editor|author|viewer).
# ADMIN_LEGACY_PASS=
# ADMIN_LEGACY_PASS_ENABLED=true
# ADMIN_LEGACY_PASS_ROLE=owner
#
# Per-account lockout after repeated failures. Per account, not per address:
# the frontend proxies every admin call server-side, so an IP counter would see
# one address for everybody.
# ADMIN_LOGIN_LOCKOUT_THRESHOLD=8
# ADMIN_LOGIN_LOCKOUT_MINUTES=15
#
# Require TOTP two-factor on every account (they can still enrol voluntarily
# without it). When true, nobody may switch their second factor back off.
# ADMIN_REQUIRE_TOTP=false
