# Application
NODE_ENV=test
PORT=3099

# Database - PostgreSQL with TimescaleDB (TEST DATABASE)
# IMPORTANT: DB_DATABASE must contain "test" for safety validation
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=parkfan_test
DB_PASSWORD=test_password_do_not_use_in_prod
DB_DATABASE=parkfan_test
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (Test instance - different port from dev to avoid conflicts)
REDIS_HOST=localhost
REDIS_PORT=6379

# Bull Queue
BULL_PREFIX=parkfan_test

# Boot-time queue work is off in tests. QueueBootstrapService and
# QueueSchedulerService both fire and forget on onModuleInit, so their work
# outlives the app that started it: the scheduler registers a five-minute
# `wait-times-cron` five seconds in, and with one Redis for the whole run that
# registration would survive into the next spec file and let WaitTimesProcessor
# fire inside an unrelated test. The bootstrap's park/queue-data queries race
# the afterEach TRUNCATE for the same rows and have deadlocked against it.
# No E2E suite asserts on either, and this is the switch the services
# themselves offer.
SKIP_QUEUE_BOOTSTRAP=true

# External APIs (Mocked in tests - these keys won't be used)
GOOGLE_API_KEY=test_mock_key
