# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=parkfan
DB_USER=postgres
DB_PASSWORD=postgres

# Model Configuration
MODEL_DIR=/app/models

# CatBoost Hyperparameters (the values below are the code defaults in config.py;
# leave them unset unless you mean to override them). Iterations x learning rate
# decide how far the model gets — see
# docs/ml/catboost-training.md#tree-count-and-early-stopping-par-902.
CATBOOST_ITERATIONS=1500
CATBOOST_LEARNING_RATE=0.1
CATBOOST_EARLY_STOPPING_ROUNDS=100
CATBOOST_DEPTH=7
CATBOOST_L2_LEAF_REG=3.0
CATBOOST_RANDOM_SEED=42

# Training Configuration
TRAIN_LOOKBACK_YEARS=2
TRAIN_TEST_SPLIT=0.8
VALIDATION_DAYS=30

# Prediction Configuration
HOURLY_PREDICTIONS=48
DAILY_PREDICTIONS=14

# Multi-Country Holiday Radius
DEFAULT_INFLUENCE_RADIUS_KM=200
