# Application
NODE_ENV=development
PORT=3000

# Database - PostgreSQL with TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=parkfan
DB_PASSWORD=parkfan_dev_password
DB_DATABASE=parkfan
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Bull Queue
BULL_PREFIX=parkfan

# Database connection pool (optional)
# DB_POOL_SIZE=80
# Ceiling on how many background-job queries may hold connections at once,
# shared across all BullMQ processors. Keep it well below DB_POOL_SIZE so the
# request path always has connections left: each processor caps its own
# fan-out, but nothing capped their sum, and six jobs at five parks each is
# the whole pool.
# DB_JOB_CONCURRENCY=12

# Origin rate limiting (circuit breaker; tunable). Keyed on the real
# client IP (CF-Connecting-IP behind Cloudflare). Set THROTTLE_LIMIT=0
# to disable. Limit is per TTL window (seconds).
# THROTTLE_TTL=60
# THROTTLE_LIMIT=300
# Bypass allow-list: a request whose THROTTLE_BYPASS_HEADER matches one of
# the comma-separated THROTTLE_BYPASS_KEYS skips rate limiting (used by our
# own frontend). Empty keys = no bypass. Keep keys secret; rotate via env.
# THROTTLE_BYPASS_HEADER=x-auth-key
# THROTTLE_BYPASS_KEYS=replace-with-a-long-random-secret

# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile on the admin login
# ──────────────────────────────────────────────────────────────────────────────
# /v1/admin/auth/login is public and reachable directly, so the challenge the
# frontend solves in the browser protects only the path a browser takes. Set
# this and the login demands a solved token from every caller that does NOT
# present a valid THROTTLE_BYPASS_KEYS value — our own frontend verifies on its
# own side and is exempt, because a token may be redeemed only once.
# Enforcement needs BOTH this and THROTTLE_BYPASS_KEYS above; with either unset
# the check stays off rather than refusing logins it cannot recognise.
# Same variable name and same value as the frontend's: one Turnstile widget
# serves the upload form and the login, so one secret verifies for both.
# TURNSTILE_SECRET_KEY=
# How long siteverify may hold a login open. Default 5000.
# ADMIN_TURNSTILE_TIMEOUT_MS=5000
# Switch the check off while the secret stays set.
# ADMIN_LOGIN_TURNSTILE=false

GOOGLE_API_KEY=SOME_GOOGLE_API_KEY

# GeoIP (GeoLite2-City) – optional; used for /discovery/nearby when no lat/lng provided
# Download: https://download.maxmind.com/geoip/databases/GeoLite2-City/download?suffix=tar.gz (Basic Auth)
# GEOIP_MAXMIND_ACCOUNT_ID=
# GEOIP_MAXMIND_LICENSE_KEY=
# GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb

# External APIs (to be added in Phase 2)
# THEMEPARKS_API_KEY=
# GEOCODING_API_KEY=
# OPENWEATHER_API_KEY=

# MeteoAlarm / MeteoGate EDR API token for weather warnings (https://api.meteoalarm.org/register)
METEOALARM_API_TOKEN=

# Frontend on-demand revalidation webhook.
# After the daily forecast batch refreshes the precomputed best-days snapshots,
# the backend POSTs {tags:[...]} to REVALIDATE_URL so the frontend drops its
# stale (day-long) best-days cache immediately. Disabled unless REVALIDATE_SECRET
# is set (keeps dev/test/CI from pinging the production frontend). The secret is
# sent as `Authorization: Bearer <secret>` — it must match the frontend endpoint.
# REVALIDATE_URL=https://park.fan/api/revalidate
# REVALIDATE_SECRET=

# ─── Admin authentication ────────────────────────────────────────────────────
# The admin surface has real accounts now (admin_users + Redis sessions), so
# /v1/admin/* needs a signed-in administrator rather than a shared secret.
#
# First run only: creates an owner account when the table is empty. The account
# is created owing a password change, so this value works exactly once — it
# lives in a deployment config and a shell history and should not survive the
# first login. Nothing happens if the table already has accounts.
# ADMIN_BOOTSTRAP_EMAIL=you@park.fan
# ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
#
# The deprecated shared pass. Kept so the maintenance scripts and the curation
# runbooks that still send `?pass=` keep working; every use is logged. Set
# ADMIN_LEGACY_PASS_ENABLED=false to close it once nothing depends on it, or
# narrow what it may do with ADMIN_LEGACY_PASS_ROLE (owner|editor|author|viewer).
# ADMIN_LEGACY_PASS=
# ADMIN_LEGACY_PASS_ENABLED=true
# ADMIN_LEGACY_PASS_ROLE=owner
#
# Per-account lockout after repeated failures. Per account, not per address:
# the frontend proxies every admin call server-side, so an IP counter would see
# one address for everybody.
# ADMIN_LOGIN_LOCKOUT_THRESHOLD=8
# ADMIN_LOGIN_LOCKOUT_MINUTES=15
#
# Require TOTP two-factor on every account (they can still enrol voluntarily
# without it). When true, nobody may switch their second factor back off.
# ADMIN_REQUIRE_TOTP=false

# ── Web push ────────────────────────────────────────────────────────────────
# Generate a pair with:  npx web-push generate-vapid-keys
# All three or none: an unconfigured deploy answers 503 on /v1/push/subscriptions
# and the notification job does not run, which is the right failure — push
# guards nothing, so taking the API down over a missing key would make every
# other endpoint depend on a feature nobody asked for.
# VAPID_SUBJECT must be a mailto: or an https URL; push services reject a JWT
# without one, which turns a config mistake into an intermittent delivery bug.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@park.fan
# Extra hosts a subscription endpoint may point at, comma-separated, ADDED to
# the four services that are always allowed (FCM, Mozilla, WNS, Apple). The
# stored endpoint is a URL this server POSTs to on a schedule, so it is checked
# against that list — without one, /v1/push/subscriptions is a request forwarder
# pointed wherever the caller likes. Set this only when a new browser ships its
# own push service; a wrong entry is an SSRF, not a typo.
# PUSH_ENDPOINT_HOSTS=
